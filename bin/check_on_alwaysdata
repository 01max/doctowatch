#!/usr/bin/env bash
set -euo pipefail

cd /home/doctowatch/doctowatch
run_id="${1:?GitHub run ID required}"
[[ "$run_id" =~ ^[0-9]+$ ]] || { echo 'Invalid GitHub run ID' >&2; exit 2; }

umask 077
trap 'rm -f tmp/.github-check-env' EXIT

set -a
source tmp/.github-check-env
set +a

rm -f tmp/report.json
status=0
CI=true bundle _2.6.7_ exec ruby check.rb || status=$?

if [[ -f tmp/report.json ]]; then
  cp tmp/report.json "tmp/report-${run_id}.json"
fi

exit "$status"
